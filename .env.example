# Database
DATABASE_URL="postgresql://user:password@localhost:5432/video_crm"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/video_crm_test"

# JWT
JWT_SECRET="generate-random-32-char-string-here"

# Node Environment
NODE_ENV="development"
DEMO_PROJECT_ID=""
DEMO_PORTAL_TOKEN=""
DEMO_WORKSPACE_ID=""
DEMO_WORKSPACE_TOKEN=""

# AI
OPENAI_API_KEY="sk-your-openai-api-key-here"

# AWS S3 (optional for MVP)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Kinescope (required for new video uploads)
KINESCOPE_API_TOKEN=""
KINESCOPE_PARENT_ID=""
KINESCOPE_PROJECT_ID=""
KINESCOPE_BASE_URL="https://api.kinescope.io/v1"
KINESCOPE_UPLOADER_BASE_URL="https://uploader.kinescope.io/v2"
KINESCOPE_WEBHOOK_SECRET=""
KINESCOPE_PLAYER_BASE_URL="https://kinescope.io"
KINESCOPE_PROJECT_PRIVACY_TYPE="anywhere"

# Email (optional for MVP)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="noreply@example.com"

# Redis (for Background Jobs)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Billing (RU-first)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_CHECKOUT_URL=""
ADMIN_EMAIL="owner@example.com"
PLATFORM_ADMIN_EMAILS="owner@example.com"
